          "scale": null
        },
        "tooltip": [
          {
            "field": "kat",
            "title": "Stav"
          },
          {
            "field": "t",
            "title": "Hodnota"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -9,
        "fontSize": 12.5,
        "fontWeight": 700
      },
      "encoding": {
        "text": {
          "value": {
            "expr": "datum.n / 100 * width > datum.minpx ? datum.t : ''"
          }
        },
        "color": {
          "field": "tbarva",
          "type": "nominal",
          "scale": null
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 12.5,
        "fontWeight": 700,
        "color": "#101432"
      },
      "encoding": {
        "text": {
          "value": {
            "expr": "datum.n / 100 * width > datum.minpx ? '' : datum.t"
          }
        }
      }
    }
  ],
  "title": {
    "text": "Izrael podle komise kontroluje {nejméně 60 %|#de1743} Gazy, příměří počítalo s 53 %",
