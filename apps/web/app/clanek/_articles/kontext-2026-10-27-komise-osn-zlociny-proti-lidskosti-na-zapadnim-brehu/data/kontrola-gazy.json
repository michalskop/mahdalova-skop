      "scale": {
        "domain": [
          0,
          100
        ],
        "nice": false
      },
      "axis": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "color": {
          "field": "barva",
