        "type": "text",
        "align": "right",
        "dx": -9,
        "fontSize": 12.5,
        "fontWeight": 700
      },
      "encoding": {
        "text": {
          "value": {
            "expr": "datum.n / 100 * width > datum.minpx ? datum.t : ''"
