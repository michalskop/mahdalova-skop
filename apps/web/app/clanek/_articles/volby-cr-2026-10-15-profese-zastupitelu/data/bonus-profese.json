            "title": "Kandidátů",
            "format": ","
          },
          {
            "field": "zvoleno",
            "title": "Zvoleno",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "dx": 4,
        "align": "left",
        "color": "#333333"
      },
      "transform": [
        {
          "filter": "datum.bonus >= 0"
        }
      ],
      "encoding": {
        "x": {
          "field": "bonus",
          "type": "quantitative"
        },
        "text": {
          "field": "popisek"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "dx": -4,
        "align": "right",
        "color": "#333333"
      },
      "transform": [
        {
          "filter": "datum.bonus < 0"
        }
      ],
      "encoding": {
        "x": {
          "field": "bonus",
          "type": "quantitative"
        },
        "text": {
          "field": "popisek"
        }
      }
    },
