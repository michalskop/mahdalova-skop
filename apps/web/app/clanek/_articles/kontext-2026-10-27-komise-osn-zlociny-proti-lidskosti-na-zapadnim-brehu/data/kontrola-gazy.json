        "minpx": 46.8
      }
    ]
  },
  "encoding": {
    "y": {
      "field": "kat",
      "type": "nominal",
      "sort": null,
      "scale": {
        "paddingInner": 0.3
      },
      "axis": {
        "title": null,
        "labelLimit": 240,
        "domain": false,
        "ticks": false,
        "labelFontSize": 12,
        "labelPadding": 8
      }
    },
    "x": {
      "field": "n",
